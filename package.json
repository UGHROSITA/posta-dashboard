{
  "name": "posta-dashboard",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev": "concurrently -n front,back -c cyan,magenta \"npm run dev -w frontend\" \"npm run dev -w backend\"",
    "dev:front": "npm run dev -w frontend",
    "dev:back": "npm run dev -w backend",
    "build": "npm run build -w frontend"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
